rules_version = '2';
// Luật bảo mật Firestore cho PetFinder. Dán vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function notBanned() { return !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false)); }
    function str(v, max) { return v is string && v.size() <= max; }

    // Quản trị viên: chỉ admin đang có quyền mới cấp/gỡ được. Admin ĐẦU TIÊN tạo thủ công trong Console (xem README).
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Hồ sơ người dùng
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.get('banned', false) == false
        && str(request.resource.data.name, 80) && str(request.resource.data.avatarPhoto, 200000);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','avatarPhoto','phone','area','bio','provider'])
            && str(request.resource.data.name, 80) && str(request.resource.data.avatarPhoto, 200000));
      allow delete: if isAdmin();
    }

    // Tin thú cưng: ai cũng xem được; chỉ chủ tin / admin được sửa, xóa
    match /pets/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && notBanned()
        && request.resource.data.ownerUid == request.auth.uid
        && str(request.resource.data.name, 80) && str(request.resource.data.desc, 1500)
        && request.resource.data.status in ['lost','found','adopt']
        && request.resource.data.imageData.size() <= 5
        && request.resource.data.get('flagged', false) == false);
      allow update: if isAdmin() || (signedIn() && notBanned()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('flagged', false) == resource.data.get('flagged', false)
        && str(request.resource.data.name, 80) && str(request.resource.data.desc, 1500)
        && request.resource.data.status in ['lost','found','adopt']
        && request.resource.data.imageData.size() <= 5);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Tin tức: ai cũng đọc, chỉ admin ghi
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Góp ý / liên hệ: ai cũng gửi được; chỉ admin và chủ yêu cầu xem; đánh giá công khai ai cũng xem
    match /feedback/{id} {
      allow read: if isAdmin() || resource.data.public == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if str(request.resource.data.message, 3000) && str(request.resource.data.name, 80) && str(request.resource.data.email, 120)
        && request.resource.data.type in ['support','feedback','bug','review','partner']
        && request.resource.data.status == 'new'
        && request.resource.data.get('reply', '') == ''
        && request.resource.data.public is bool
        && (request.resource.data.ownerUid == '' || (signedIn() && request.resource.data.ownerUid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Sổ giao dịch (bảng điều khiển doanh thu): chỉ admin
    match /tx/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
