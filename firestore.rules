rules_version = '2';
// Luật bảo mật Firestore cho PetFinder. Dán vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Tài khoản email/mật khẩu phải xác thực email (email_verified) mới được ghi/đọc liên hệ; đăng nhập Google luôn có email_verified = true
    function verified() { return request.auth.token.email_verified == true; }
    // Không bị khóa: chưa có hồ sơ thì coi là không bị khóa (tránh từ chối oan); bị khóa khi hồ sơ có banned = true
    function notBanned() {
      return verified() && !(exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true);
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // Quản trị viên: chỉ admin đang có quyền mới cấp/gỡ được. Admin ĐẦU TIÊN tạo thủ công trong Console (xem README).
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Hồ sơ người dùng
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.get('banned', false) == false
        && request.resource.data.keys().hasOnly(['uid','name','avatar','avatarPhoto','email','phone','role','banned','area','bio','provider'])
        && str(request.resource.data.name, 80) && str(request.resource.data.get('phone', ''), 40) && str(request.resource.data.get('area', ''), 80)
        && str(request.resource.data.get('bio', ''), 500) && str(request.resource.data.get('avatar', ''), 16)
        && str(request.resource.data.get('avatarPhoto', ''), 200000);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','avatarPhoto','phone','area','bio','provider'])
            && str(request.resource.data.name, 80) && str(request.resource.data.get('phone', ''), 40) && str(request.resource.data.get('area', ''), 80)
            && str(request.resource.data.get('bio', ''), 500) && str(request.resource.data.avatarPhoto, 200000));
      allow delete: if isAdmin();
    }

    // Dấu "đã bị admin xóa": Firebase Auth không cho xóa tài khoản đăng nhập từ trình duyệt, nên đánh dấu để chặn đăng nhập lại.
    // Chỉ admin tạo dấu; chính chủ được xóa dấu của mình khi chủ động đăng ký lại.
    match /deleted_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Tin thú cưng (CÔNG KHAI): chỉ chứa thông tin mô tả. SĐT/Zalo/email KHÔNG được phép nằm ở đây (xem pet_contacts bên dưới).
    function petShape(d) {
      return d.keys().hasOnly(['id','name','type','breed','gender','date','area','location','desc','status','icon','imageData','lat','lng','ownerName','ownerUid','createdAt','flagged'])
        && str(d.name, 80) && str(d.get('type', ''), 30) && str(d.get('breed', ''), 60) && str(d.get('gender', ''), 20)
        && str(d.get('area', ''), 80) && str(d.get('location', ''), 200) && str(d.get('date', ''), 32)
        && str(d.get('desc', ''), 1500) && str(d.get('icon', ''), 8) && str(d.get('ownerName', ''), 80)
        && d.status in ['lost','found','adopt']
        && d.get('imageData', []) is list && d.get('imageData', []).size() <= 5
        && imgOk(d.get('imageData', []), 0) && imgOk(d.get('imageData', []), 1) && imgOk(d.get('imageData', []), 2) && imgOk(d.get('imageData', []), 3) && imgOk(d.get('imageData', []), 4);
    }
    // Mỗi ảnh là chuỗi, tối đa ~900 KB (giới hạn tài liệu Firestore là 1 MiB)
    function imgOk(l, i) { return l.size() <= i || (l[i] is string && l[i].size() <= 900000); }
    match /pets/{id} {
      allow read: if true;
      allow create: if (isAdmin() || (signedIn() && notBanned() && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.get('flagged', false) == false))
        && petShape(request.resource.data);
      allow update: if (isAdmin() || (signedIn() && notBanned()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.get('flagged', false) == resource.data.get('flagged', false)))
        && petShape(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Thông tin liên hệ của tin (SĐT, Zalo, email): TÁCH khỏi tài liệu công khai.
    // - Chỉ người đã đăng nhập (không bị khóa) đọc được từng tài liệu theo id; KHÔNG ai ngoài admin được liệt kê cả bộ sưu tập.
    // - Chỉ chủ tin hoặc admin được ghi/xóa.
    match /pet_contacts/{id} {
      allow get: if signedIn() && notBanned();
      allow list: if isAdmin();
      allow create, update: if (isAdmin() || (signedIn() && notBanned()
          && getAfter(/databases/$(database)/documents/pets/$(id)).data.ownerUid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['phone','zalo','email','ownerUid'])
        && str(request.resource.data.get('phone', ''), 40) && str(request.resource.data.get('zalo', ''), 200)
        && str(request.resource.data.get('email', ''), 120) && str(request.resource.data.get('ownerUid', ''), 128);
      allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/pets/$(id)).data.ownerUid == request.auth.uid);
    }

    // Tin tức: ai cũng đọc, chỉ admin ghi
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Góp ý / liên hệ: ai cũng gửi được; chỉ admin và chủ yêu cầu xem; đánh giá công khai ai cũng xem
    match /feedback/{id} {
      allow read: if isAdmin() || resource.data.public == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['id','createdAt','name','email','type','rating','message','public','status','reply','repliedAt','userEmail','ownerUid'])
        && str(request.resource.data.get('userEmail', ''), 120)
        && (request.resource.data.get('userEmail', '') == '' || (signedIn() && request.resource.data.userEmail == request.auth.token.email))
        && str(request.resource.data.message, 3000) && str(request.resource.data.name, 80) && str(request.resource.data.email, 120)
        && request.resource.data.type in ['support','feedback','bug','review','partner']
        && request.resource.data.status == 'new'
        && request.resource.data.get('reply', '') == ''
        && request.resource.data.public is bool
        && (request.resource.data.ownerUid == '' || (signedIn() && request.resource.data.ownerUid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Sổ giao dịch (bảng điều khiển doanh thu): chỉ admin
    match /tx/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
